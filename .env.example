# PlainSpeak — Environment Configuration
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to version control.

# ─── AI backend — choose ONE of Anthropic or Ollama ─────────────────────────

# ── Option A: Anthropic / Claude (cloud) ─────────────────────────────────────
# Get your key at https://console.anthropic.com/
# Leave blank to auto-switch to Ollama.
ANTHROPIC_API_KEY=
# (Leave blank — Ollama is used automatically when this is empty)

# Model to use if you do have a Claude key
ANTHROPIC_MODEL=claude-opus-4-5

# Reasoning effort: low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium

# Server-side fallback ("default" or leave empty to disable)
ANTHROPIC_FALLBACKS=default

# ── Option B: Ollama (local, free, no API key needed) ────────────────────────
# 1. Install Ollama: https://ollama.ai
# 2. Pull a model: ollama pull llama3.1
# 3. Start Ollama: ollama serve
# Ollama is used automatically when ANTHROPIC_API_KEY is blank above.
USE_OLLAMA=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Recommended models (best JSON output quality):
#   llama3.1      — best overall quality, 8B params (~5 GB)
#   qwen2.5:7b    — excellent at structured JSON, fast
#   mistral:7b    — fast, reliable
#   phi3.5:mini   — smallest (~2 GB), good for low-RAM machines

# ─── Voice / Reson8 (optional — enables live voice input) ────────────────────
RESON8_API_KEY=your-reson8-key-here

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3001

# Bind address: 127.0.0.1 for local dev; 0.0.0.0 for Docker / cloud
HOST=127.0.0.1

# Environment: development | production
APP_ENV=development

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# For production add your real domain, e.g.: https://app.plainspeak.health
CORS_ORIGINS=http://localhost:3001,http://localhost:8000

# ─── Data storage ────────────────────────────────────────────────────────────
# Directory for case JSON files and uploaded PDFs.
PLAINSPEAK_DATA_DIR=data
